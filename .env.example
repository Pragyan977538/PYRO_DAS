# ---------------------------------------------------------------------------
# Copy to .env and edit.  Never commit .env.
# ---------------------------------------------------------------------------

# Postgres connection.  Must match docker-compose.yml.
POSTGRES_DB=firewatch
POSTGRES_USER=firewatch
POSTGRES_PASSWORD=firewatch
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://firewatch:firewatch@localhost:5432/firewatch

# 1 = run the whole pipeline against the synthetic generator (no API keys needed).
# 0 = live data; the keys below then become required and config.py will refuse to
#     start if any is missing.
MOCK_MODE=1

# NASA FIRMS.  Free, emailed instantly: firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Earth Observation Group, for VIIRS Nightfire.  Free account: eogdata.mines.edu
EOG_USERNAME=
EOG_PASSWORD=

# Bounding box for every area query: west,south,east,north
INDIA_BBOX=68,6,98,37

# Where downloaded and generated data lives.  Gitignored.
DATA_DIR=./data

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
