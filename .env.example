# ---------------------------------------------------------------------------
# Copy to .env and edit.  Never commit .env.
# ---------------------------------------------------------------------------

# Postgres connection.  Must match docker-compose.yml.
POSTGRES_DB=firewatch
POSTGRES_USER=firewatch
POSTGRES_PASSWORD=firewatch
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://firewatch:firewatch@localhost:5432/firewatch

# 0 = real data (default). The FIRMS archive for India is public, so no key is
#     needed to start; each client asks for its own key only when it runs.
# 1 = the synthetic test fixture: offline and deterministic, for tests and CI.
MOCK_MODE=0

# NASA FIRMS API key. Needed ONLY for API pulls: 2025 onward and the live NRT feed.
# The 2012-2024 yearly archive needs none. Free, emailed instantly:
# firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Earth Observation Group, for VIIRS Nightfire temperatures. OPTIONAL enrichment:
# leave both empty to run without it. Needs the free academic licence (signed
# agreement + approval): payneinstitute.mines.edu/viirs-nightfire-licensing/
EOG_USERNAME=
EOG_PASSWORD=

# Bounding box for every area query: west,south,east,north
INDIA_BBOX=68,6,98,37

# Where downloaded and generated data lives.  Gitignored.
DATA_DIR=./data

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
